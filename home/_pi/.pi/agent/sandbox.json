{
  "enabled": true,
  "sandboxUserShell": true,
  "permissionPromptTimeoutSeconds": 300,
  "network": {
    "allowLocalBinding": false,
    "allowAllUnixSockets": false,
    "allowUnauthenticatedSocksProxy": false,
    "allowedDomains": [
      "localhost",
      "127.0.0.1",
      "*.github.com",
      "*.githubusercontent.com",
      "*.npmjs.org",
      "*.pypi.org",
      "*.nixos.org",
      "cache.nixos.org",
      "channels.nixos.org",
      "repo1.maven.org",
      "repo.maven.apache.org"
    ],
    "deniedDomains": []
  },
  "filesystem": {
    "denyRead": [
      "/home/ncarchar/.ssh",
      "/home/ncarchar/.gnupg",
      "/home/ncarchar/.aws",
      "/home/ncarchar/.config/gh",
      "/home/ncarchar/.netrc",
      "/home/ncarchar/.git-credentials"
    ],
    "allowRead": [
      ".",
      "~/code",
      "~/.cache",
      "~/.local/share"
    ],
    "allowWrite": [
      ".",
      "/tmp",
      "~/.cache",
      "~/.local/share"
    ],
    "denyWrite": [
      "/home/ncarchar/.ssh",
      "/home/ncarchar/.gnupg",
      "/home/ncarchar/.aws",
      "/home/ncarchar/.config/gh",
      "/home/ncarchar/.netrc",
      "/home/ncarchar/.git-credentials",
      ".env",
      ".env.*",
      "*.pem",
      "*.key",
      "*.gpg"
    ]
  }
}
