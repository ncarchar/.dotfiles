{
    "enabled": true,
    "sandboxUserShell": true,
    "permissionPromptTimeoutSeconds": 180,
    "network": {
        "allowLocalBinding": false,
        "allowAllUnixSockets": true,
        "allowUnauthenticatedSocksProxy": false,
        "allowedDomains": [
            "localhost",
            "127.0.0.1",
            "*.github.com",
            "*.githubusercontent.com",
            "*.npmjs.org",
            "openrouter.ai",
            "*.pypi.org",
            "*.nixos.org",
            "cache.nixos.org",
            "channels.nixos.org",
            "repo1.maven.org",
            "repo.maven.apache.org"
        ],
        "deniedDomains": []
    },
    "filesystem": {
        "denyRead": [
            "~/.ssh",
            "~/.gnupg",
            "~/.aws",
            "~/.config/gh",
            "~/.netrc",
            "~/.git-credentials",
            "~/.pi/agent/auth.json"
        ],
        "allowRead": [
            ".",
            "~/code",
            "~/.cache",
            "~/.local/share",
            "~/.pnpm/",
            "~/.pi/agent",
            "/nix/store"
        ],
        "allowWrite": [
            ".",
            "/tmp",
            "~/.cache",
            "~/.local/share",
            "~/.pnpm/",
            "~/code",
            "~/.gradle/wrapper/dists"
        ],
        "denyWrite": [
            "~/.ssh",
            "~/.gnupg",
            "~/.aws",
            "~/.config/gh",
            "~/.netrc",
            "~/.git-credentials",
            ".env"
        ]
    }
}
