**/lazy-lock.json
*.log

# pi runtime state, secrets, and internet-installed packages — never commit.
# These live in ~/.pi/agent/ as real files; the entries below are a defensive
# guard in case any are ever copied into the _pi stow package.
# (settings.json IS committed intentionally — it references installed packages.)
home/_pi/.pi/agent/auth.json
home/_pi/.pi/agent/models-store.json
home/_pi/.pi/agent/sessions/
home/_pi/.pi/agent/npm/
home/_pi/.pi/agent/git/
home/_pi/.pi/agent/sandbox.json
home/_pi/.pi/agent/web-search-cache/

# Failsafe — never commit credentials or env files, at any depth.
auth.json
.env
.env.*
